# Red de Acopio y Refugio — configuración de ejemplo
# Copia este archivo como .env y completa tus valores. NUNCA subas el .env real a git.

# --- Telegram (lectura del canal con Telethon) ---
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_CANAL=

# --- Anthropic (clasificación de mensajes con IA) ---
ANTHROPIC_API_KEY=
MODELO_FUERTE=claude-opus-4-8
MODELO_RAPIDO=claude-haiku-4-5
LIMITE_MENSAJES=80

# --- Bot de moderación (Telegram) ---
TELEGRAM_BOT_TOKEN=
GRUPO_MODERADORES=

# --- Bot de afiliación de representantes (Telegram) ---
APOYO_BOT_TOKEN=
AUTO_APROBAR=0
AUTO_PUBLICAR_PEDIDOS=0

# --- Bot de alertas / avisos internos ---
ALERTAS_BOT_TOKEN=
ALERTAS_TG_IDS=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WA_TPL_LLAMADO=
AVISO_WHATSAPP=

# --- Panel privado de capturas (login básico) ---
PANEL_USER=
PANEL_PASS=

# --- API institucional (aliados) ---
INSTITUCION_API_KEY=

# --- Observabilidad (opcional) ---
SENTRY_DSN=
SENTRY_ENV=produccion
LOG_LEVEL=INFO
